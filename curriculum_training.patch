+    # --------------------------------------------------------
+    # CURRICULUM NORMALIZATION TRANSFER
+    # --------------------------------------------------------
+    # Within an MC curriculum, C2-C7 reuse the previous stage's
+    # policy parameters.  Reuse the corresponding VecNormalize
+    # statistics as well so the observation scale is continuous
+    # across curriculum stages.
+    #
+    # Do NOT carry this across MC0 -> MC1 -> MC2 -> MC3: each MC
+    # intentionally starts from a fresh policy architecture/lookahead
+    # configuration at C1.
+    if args.pretrained:
+        pretrained_dir = os.path.dirname(
+            os.path.abspath(args.pretrained)
+        )
+        pretrained_vecnorm = os.path.join(
+            pretrained_dir,
+            "vecnormalize.pkl",
+        )
+
+        if os.path.isfile(pretrained_vecnorm):
+            print(
+                "[Curriculum] Loading VecNormalize statistics from: "
+                f"{pretrained_vecnorm}"
+            )
+            env = VecNormalize.load(
+                pretrained_vecnorm,
+                env,
+            )
+            env.training = True
+            env.norm_reward = True
+        else:
+            print(
+                "[Curriculum] WARNING: pretrained model supplied but "
+                "vecnormalize.pkl was not found. Starting with fresh "
+                "normalization statistics."
+            )
